{
    "name": "wisebits-chat",
    "version": "1.0.0",
    "private": true,
    "description": "Wisebits Chat Application - Full Stack Chat with Stories",
    "scripts": {
        "dev:backend": "cd backend && pnpm start:dev",
        "dev:frontend": "cd frontend && pnpm dev",
        "dev": "concurrently \"pnpm dev:backend\" \"pnpm dev:frontend\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
        "build:backend": "cd backend && pnpm build",
        "build:frontend": "cd frontend && pnpm build",
        "build": "pnpm build:backend && pnpm build:frontend",
        "test:backend": "cd backend && pnpm test",
        "test:frontend:unit": "cd frontend && pnpm test:unit",
        "test:e2e:playwright": "cd frontend && pnpm build && pnpm preview & sleep 5 && pnpm test:e2e; kill %1",
        "test:e2e:bdd": "cd frontend && pnpm build && pnpm preview & sleep 5 && pnpm test:bdd; kill %1",
        "test:e2e": "pnpm test:e2e:bdd",
        "test": "pnpm test:backend && pnpm test:e2e:bdd",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:restart": "docker-compose restart",
        "start": "pnpm docker:up && pnpm dev"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}